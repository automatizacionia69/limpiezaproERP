# Copiar a .env.local y completar con los valores reales.
# Nunca commitear .env.local ni escribir credenciales en este archivo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API paga de RENIEC/SUNAT (consulta de RUC/DNI en formularios de clientes/proveedores)
DECOLECTA_API_TOKEN=

# API paga de Google Gemini (lectura de imagen/PDF de factura o boleta en Compras > Nueva)
# OJO: el nombre lleva prefijo a propósito para no chocar con un GEMINI_API_KEY
# que ya exista como variable de entorno del sistema en tu máquina — si existe,
# gana sobre .env.local y la IA falla con "API key not valid" sin avisar por qué.
LIMPIEZAPRO_GEMINI_API_KEY=
# Opcional — modelo a usar, por defecto gemini-flash-latest
GEMINI_MODEL=

# SMTP para enviar correos directo desde el servidor (botón "Enviar por correo"
# en Cotizaciones) — cada despliegue usa su propia cuenta.
# Gmail: activa verificación en 2 pasos y genera una "contraseña de aplicación"
#   en myaccount.google.com/apppasswords. Usa SMTP_HOST=smtp.gmail.com, PORT=587.
# Outlook/Microsoft 365: genera una contraseña de aplicación en
#   account.microsoft.com/security. Usa SMTP_HOST=smtp.office365.com, PORT=587.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Opcional — remitente que verá el cliente, ej: "LimpiezaPro <tu_correo@gmail.com>"
SMTP_FROM=

# NUBEFACT (OSE peruano) — envía facturas/boletas reales a SUNAT al emitir
# una venta. Sin estas dos, el comprobante se guarda igual en el ERP pero
# queda con nubefact_estado='error' (reintentable desde Consulta de Ventas).
NUBEFACT_RUTA=
NUBEFACT_TOKEN=
